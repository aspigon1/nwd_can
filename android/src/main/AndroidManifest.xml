<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.radiodash.nwdcan">
    <!-- Android 11+ needs an explicit query to see/bind another app's service by package -->
    <queries>
        <package android:name="com.nwd.can.setting" />
    </queries>
    <!-- Bluetooth permissions for the OBD-II BLE adapter. Declared here in the
         plugin manifest so Gradle's manifest merger folds them into the final
         APK on every build path (including FlutterFlow's cloud build), which the
         app manifest alone does not get. BLUETOOTH + BLUETOOTH_ADMIN cover
         Android <= 11 (required for BLE scanning there); BLUETOOTH_SCAN +
         BLUETOOTH_CONNECT cover Android 12+. -->
    <uses-permission android:name="android.permission.BLUETOOTH" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" />
    <uses-permission android:name="android.permission.BLUETOOTH_SCAN" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <!-- Media "now playing" from other apps (radio / BT music) via the
         nowplaying package's NotificationListenerService. Declared here so the
         manifest merger folds the service into the final APK on every build
         path (incl. FlutterFlow cloud). The user still grants Notification
         Access once in Settings; this only registers the service. -->
    <application>
        <service
            android:name="com.gomes.nowplaying.NowPlayingListenerService"
            android:label="radio dashboard"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE"
            android:exported="true">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>
    </application>
</manifest>
